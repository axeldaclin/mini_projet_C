#include <stdio.h>

int main()
{
    
    int taille;
    float moyenne=0;
    printf("Combien de valeurs a rentrer ?\n");
    scanf("%d",&taille);
    if (taille > 20)
    {
        printf("erreur trop d'elements");
    }
    else
    {
        int tableau [taille];
        for (int i=0 ; i< taille;i++)
        {
            printf("rentrez la valeur %d\n",i+1);
            scanf("%d",&tableau[i]);
        }
        int max=tableau[0];
        int min=tableau[0];
        for (int i=0 ; i< taille;i++)
        {
            if (tableau[i]> max)
            {
                max=tableau[i];
            }
            if (tableau[i]<min)
            {
                min=tableau[i];
            }
            moyenne=moyenne+tableau[i];
        }
        printf("la valeur max est %d\n",max);
        printf("la valeur min est %d\n",min);
        moyenne = moyenne/taille;
        printf("la moyenne est: %f\n",moyenne);
        int k,l;
        for (k=0;k<taille-1;k++)
        {
            for(l=0;l<taille-k-1;l++)
            {
                if(tableau[l]>tableau[l+1])
                {
                    int temp = tableau[l];
                    tableau[l] = tableau[l + 1];
                    tableau[l + 1] = temp;
                }
            }
        }
        
        
        
        for (int i=0;i< taille;i++)
        {
            printf("%d\n",tableau[i]);
        }
    }
}
